# Database
MONGODB_URL=mongodb://localhost:27017/quizbuzz
MONGODB_URI=mongodb://localhost:27017/quizbuzz

# Redis
REDIS_URL=redis://localhost:6379

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5178,https://quiz.ysminfosolution.com

# Frontend build/runtime URLs
VITE_API_URL=https://quiz.ysminfosolution.com/api
VITE_SOCKET_URL=wss://quiz.ysminfosolution.com/socket.io

# Server Configuration
PORT=5000
NODE_ENV=development
API_VERSION=1.0.0

# Authentication & Security
JWT_SECRET=your_jwt_secret_here
OTP_SECRET=your_otp_secret_here
VITE_SECRET_KEY=your_crypto_js_secret_here

# Services (Examples)
SMS_API_KEY=your_sms_gateway_key
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Razorpay note: KEY_SECRET and WEBHOOK_SECRET are different values in the dashboard.

# MSG91
MSG91_AUTH_KEY=
MSG91_TEMPLATE_REGISTRATION=
MSG91_TEMPLATE_PAYMENT=
MSG91_TEMPLATE_REMINDER=
MSG91_TEMPLATE_RESULT=
MSG91_TEMPLATE_OTP=

# SendGrid
SENDGRID_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=QuizBuzz

# OTP
OTP_EXPIRY_SECONDS=600

# Frontend URLs (for CORS)
FRONTEND_URL=http://localhost:3000
